---
const links = [
    { label: "about", href: "#about" },
    { label: "projects", href: "#projects" },
    { label: "contact", href: "#contact" },
];
---

<nav class="fixed top-0 z-50 w-full border-b border-white/5 bg-void/70 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a 
            href="#"
            class="group flex items-center gap-2 text-sm font-bold tracking-widest"
        >
            <span class="text-glitch">4</span><span class="text-muted">0</span><span class="text-glitch-2">4</span>
            <span class="text-white/80 group-hover:text-white">/FourUhOhFour</span>
        </a>

        <ul class="hidden items-center gap-8 text-sm sm:flex">
            { links.map((link) => (
                <li>
                    <a 
                        href={ link.href }
                        class="text-muted transition-colors hover:text-glitch"
                    >{ link.label }</a>
                </li>
            )) }
        </ul>
    </div>
</nav>
