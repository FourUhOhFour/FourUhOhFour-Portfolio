---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: sting;
}

const {
	title = "FourUhOhFour // dev portfolio",
	description = "The portfolio of FourUhOhFour - developer, tinkerer, breaker of things"
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={ description } />
		<title>{ title }</title>
	</head>
	<body>
		<slot />
	</body>
</html>
